# deploy/docker/.env.example —— 容器形态环境变量样例。
#
# 用法：
#   cp deploy/docker/.env.example deploy/docker/.env
#   # 生成强随机值（Linux/macOS）：
#   #   openssl rand -hex 24   # 数据库口令
#   #   openssl rand -hex 32   # JWT / 审计 HMAC 密钥
#   # 编辑 .env 后执行：
#   docker compose -f deploy/docker/docker-compose.yml --env-file deploy/docker/.env up -d --build
#
# 注意：.env 含密钥，禁止提交到版本库（本文件仅为样例，值必须替换）。

VERSION=0.1.0

# 数据库账号/库名（与 postgres 服务初始化参数一致）
AUTO_PERF_DATABASE_USER=autoperf
AUTO_PERF_DATABASE_NAME=auto_performance
# 数据库口令（替换为强随机值，长度 >=16）
AUTO_PERF_DB_PASSWORD=replace-with-random-db-password

# JWT 签名密钥（替换为 32 字节随机 hex）
AUTO_PERF_JWT_SECRET=replace-with-64-hex-chars-jwt-secret
# 审计链 HMAC 密钥（替换为 32 字节随机 hex）
AUTO_PERF_AUDIT_HMAC_KEY=replace-with-64-hex-chars-audit-hmac-key

# 可选：容器内压测/PDF 运行时路径（挂载离线运行时后使用）
# AUTO_PERF_K6_BINARY_PATH=/opt/auto_performance/bin/k6
# AUTO_PERF_CHROMIUM_PATH=/opt/auto_performance/runtime/chromium/chrome
